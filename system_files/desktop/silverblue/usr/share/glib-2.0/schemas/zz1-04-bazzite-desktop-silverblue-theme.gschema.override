'Digital Output (S/PDIF) – GoMic compact condenser mic': 'Digital Output (S/PDIF) – GoMic compact condenser mic', \
'Digital Output (S/PDIF) – Starship/Matisse HD Audio Controller': 'Digital Output (S/PDIF) – Starship/Matisse HD Audio Controller', \
'Digital Output (S/PDIF) – USB Audio': 'Digital Output (S/PDIF) – USB Audio', \
'Dummy Output': 'Dummy Output', \
'Easy Effects Sink': 'Easy Effects Sink', \
'HDMI / DisplayPort – GA102 High Definition Audio Controller': 'HDMI / DisplayPort – GA102 High Definition Audio Controller', \
'HDMI / DisplayPort 2 – GA102 High Definition Audio Controller': 'HDMI / DisplayPort 2 – GA102 High Definition Audio Controller', \
'Headphones – Starship/Matisse HD Audio Controller': 'Headphones – Starship/Matisse HD Audio Controller', \
'Speakers – GoMic compact condenser mic': 'Speakers – GoMic compact condenser mic' \
}

[org.gnome.shell.extensions.tilingshell]
inner-gaps=0
outer-gaps=0
top-edge-maximize=true
quarter-tiling-threshold=25
enable-tiling-system-windows-suggestions=true
enable-screen-edges-windows-suggestions=true

[org.gnome.shell.extensions.vertical-workspaces]
app-grid-columns=6
app-grid-content=2
app-grid-folder-columns=4
app-grid-folder-rows=4
app-grid-folder-spacing=12
app-grid-icon-size=64
app-grid-spacing=12
hot-corner-action=0
ws-thumbnails-position=5
wst-position-adjust=0

[org.gnome.shell.extensions.window-list]
display-all-workspaces=true
show-on-all-monitors=true
