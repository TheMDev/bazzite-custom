'Digital Input (S/PDIF) – USB Audio': 'Digital Input (S/PDIF) – USB Audio', \
'Easy Effects Source': 'Easy Effects Source', \
'Microphone – GoMic compact condenser mic': 'Microphone – GoMic compact condenser mic', \
'Microphone – USB Audio': 'Microphone – USB Audio' \
}
output-names-map={ \
